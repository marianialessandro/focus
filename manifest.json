{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "description": "Blocks distracting websites while you should be focusing.",
  "version": "0.1.0",

  "permissions": [
    "alarms",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",

    "*://*.instagram.com/*",
    "*://instagram.com/*",

    "*://*.netflix.com/*",
    "*://netflix.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html"
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html",
        "src/blocked/blocked.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
